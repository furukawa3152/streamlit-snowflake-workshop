# 公式のキーペア認証例 / 値はすべて置き換え用
# このファイルをコピーして .streamlit/secrets.toml を作り、YOUR_... を自分の値に置き換えてください。
# secrets.toml は絶対にコミットしないでください（.gitignore 済み）。
[connections.snowflake]
account = "YOUR_ORG-YOUR_ACCOUNT"
user = "YOUR_USER"
private_key_file = "YOUR_PRIVATE_KEY_FILE"
role = "YOUR_ROLE"
warehouse = "YOUR_WAREHOUSE"
database = "YOUR_DATABASE"
schema = "YOUR_SCHEMA"
